source: crates/web/src/tests.rs
expression: "readable(&f, &page.body)"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content="{&quot;includeIndicatorStyles&quot;:false,&quot;allowEval&quot;:false,&quot;allowScriptTags&quot;:false}">
<title>Dashboard · sanic-review</title>
<link rel="stylesheet" href="/assets/style.css">
<script src="/assets/htmx.min.js" defer>
</script>
<script src="/assets/app.js" defer>
</script>
</head>
<body data-page="index" hx-headers="{&quot;x-csrf-token&quot;:&quot;<token>&quot;}">
<header class="topbar">
<a class="home" href="/">sanic-review</a>
<span class="counts" id="counts">
<b>0</b> queued · <b>0</b> running · <b class="cnt">3</b> pending drafts <span class="muted-sep">|</span> <span class="k">?</span> keys</span>
</header>
<main>
<div id="panes" hx-get="/?archived=false" hx-trigger="every 5s" hx-select="#panes" hx-select-oob="#counts" hx-swap="outerHTML" data-show-archived="false">
<section class="list" id="owed">
<h2>Reviews you owe <span class="dim">3</span>
<span class="sp">
</span>
</h2>
<div class="group-h act">NEEDS YOU · 2</div>
<div class="ib" data-row data-key="org/repo#7" data-href="/pr/org/repo/7" data-ignore="/pr/org/repo/7/ignore" data-chat="/pr/org/repo/7#chat">
<span class="n">
<span class="newdot" title="a review you haven't looked at yet">
</span>
</span>
<span class="x">
<span class="cnt">3 drafts</span>
</span>
<span class="t">
<a href="/pr/org/repo/7" title="Add the thing">Add the thing</a>
</span>
<span class="m">
<a class="ref" href="https://github.com/org/repo/pull/7" title="https://github.com/org/repo/pull/7">org/repo#7 ↗</a> · alice · drafted · <span class="u-act">1 unanswered</span>
</span>
<span class="a">
<a class="linkbtn" href="/pr/org/repo/7/ignore">ignore by title <span class="k">i</span>
</a>
<a class="linkbtn" href="/pr/org/repo/7#chat">chat <span class="k">c</span>
</a>
<form class="archive" method="post" action="/pr/org/repo/7/archive">
<input type="hidden" name="csrf" value="<token>">
<input type="hidden" name="archived" value="true">
<input type="hidden" name="next" value="index">
<button class="linkbtn" type="submit">archive <span class="k">a</span>
</button>
</form>
</span>
</div>
<div class="ib" data-row data-key="org/repo#8" data-href="/pr/org/repo/8" data-review-now="/pr/org/repo/8/review-now" data-ignore="/pr/org/repo/8/ignore">
<span class="n">
</span>
<span class="x">
<span class="chip bad">failed</span>
</span>
<span class="t">
<a href="/pr/org/repo/8" title="Fix &lt;script&gt; escaping">Fix &lt;script&gt; escaping</a>
</span>
<span class="m">
<a class="ref" href="https://github.com/org/repo/pull/8" title="https://github.com/org/repo/pull/8">org/repo#8 ↗</a> · bob · <span class="u-quiet">changes requested</span> · <span class="error" title="claude exited with 1
and more detail">claude exited with 1</span>
</span>
<span class="a">
<a class="linkbtn" href="/pr/org/repo/8/review-now">review now <span class="k">r</span>
</a>
<a class="linkbtn" href="/pr/org/repo/8/ignore">ignore by title <span class="k">i</span>
</a>
<form class="archive" method="post" action="/pr/org/repo/8/archive">
<input type="hidden" name="csrf" value="<token>">
<input type="hidden" name="archived" value="true">
<input type="hidden" name="next" value="index">
<button class="linkbtn" type="submit">archive <span class="k">a</span>
</button>
</form>
</span>
</div>
<details class="grp quiet" id="owed-quiet">
<summary>
<div class="group-h">NOTHING TO DO NOW · 1<span class="dim"> — skipped, archived, or done; r reviews one anyway</span>
</div>
</summary>
<div class="ib" data-row data-key="org/repo#10" data-href="/pr/org/repo/10" data-review-now="/pr/org/repo/10/review-now" data-ignore="/pr/org/repo/10/ignore">
