<span class="sev major">major</span>
<span class="dim conf">high conf.</span>
<span class="sp">
<form class="decide" method="post" action="/drafts/2/status" hx-post="/drafts/2/status" hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:queue all">
